---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';

const differentiators = [
  { title: 'AI backbone, human judgement', body: 'Automation handles the repetitive. Our team handles the nuanced calls that actually need a person.' },
  { title: 'Solution-first, not headcount-first', body: "You're buying an outcome, not another line on the payroll." },
  { title: 'Built for Australian compliance', body: 'Fair Work, STP, BAS, GST — the rules are already baked into how we work.' },
  { title: 'No lock-in to start', body: 'Cancel your entry-tier service anytime with 30 days notice. No long contracts to test the waters.' },
];

const glance = [
  { label: '7 service areas', body: 'Bookkeeping to systems, available on their own or bundled.' },
  { label: '3 tiers per area', body: 'Start with one defined task, grow into a fractional Operations Partner.' },
  { label: 'Human-reviewed, always', body: 'Every output is checked by a named person before it reaches you.' },
  { label: 'Live in 5 business days', body: 'For L1 services — onboard online, we take it from there.' },
];
---

<Layout title="Your AI-powered Operations Partner for Australian small business">
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 pt-16 pb-20 md:pt-24 md:pb-28 grid md:grid-cols-[1.15fr_0.85fr] gap-14 items-center">
      <div class="reveal">
        <h1 class="font-[General_Sans] font-bold text-[2.6rem] leading-[1.05] tracking-tight md:text-[3.6rem]">
          Run your business.<br />
          Let <span class="text-teal-dark italic">Neuronex</span> run<br />
          the rest.
        </h1>
        <p class="mt-6 text-lg text-slate leading-relaxed max-w-lg">
          Neuronex is an AI-powered second-in-command for small business —
          bookkeeping, admin, HR, ops, marketing and customer service,
          handled by automation and reviewed by real people, every time.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="/contact" class="inline-flex items-center rounded-full bg-amber text-ink px-7 py-3.5 font-semibold hover:brightness-95 hover:-translate-y-0.5 transition-all">
            Book a scoping call
          </a>
          <a href="/services" class="inline-flex items-center gap-1.5 text-ink font-semibold hover:text-teal-dark hover:gap-2.5 transition-all">
            See all service areas
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </a>
        </div>
      </div>

      <div class="relative reveal reveal-delay-2 md:mt-10">
        <div class="rounded-2xl bg-ink text-sand shadow-xl overflow-hidden">
          <div class="flex items-center gap-2 px-5 py-4 border-b border-sand/10">
            <span class="w-2.5 h-2.5 rounded-full bg-teal"></span>
            <span class="text-xs font-semibold tracking-wide text-sand/70">Your Operations Partner, at a glance</span>
          </div>
          <div class="px-5 py-5 space-y-5">
            {glance.map((g) => (
              <div class="flex gap-3.5">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 mt-0.5">
                  <circle cx="9" cy="9" r="8" stroke="#4FAE7F" stroke-width="1.4"/>
                  <path d="M5.4 9.2L7.7 11.5L12.6 6.3" stroke="#4FAE7F" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div>
                  <p class="font-semibold text-sand text-[0.95rem]">{g.label}</p>
                  <p class="text-sand/60 text-sm mt-0.5">{g.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-2xl reveal">
      <h2 class="font-[General_Sans] font-bold text-3xl md:text-5xl tracking-tight">
        You didn't start a business to spend your days on admin.
      </h2>
      <p class="mt-5 text-slate text-xl leading-relaxed" style="font-family: Georgia, serif;">
        Chasing invoices, wrangling rosters, keeping the books straight —
        it's necessary, but it's not the job.
      </p>
    </div>

    <div class="mt-16 grid sm:grid-cols-2 gap-x-10 gap-y-12">
      {differentiators.map((d, i) => (
        <div class={`flex gap-4 reveal reveal-delay-${(i % 3) + 1} ${i % 2 === 1 ? 'sm:mt-8' : ''}`}>
          <div class="w-2 shrink-0 rounded-full bg-teal"></div>
          <div>
            <h3 class="font-semibold text-lg">{d.title}</h3>
            <p class="mt-1.5 text-slate leading-relaxed">{d.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-ink text-sand py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 reveal">
        <div class="max-w-lg">
          <h2 class="font-[General_Sans] font-bold text-3xl md:text-4xl tracking-tight">
            Seven areas. One Operations Partner.
          </h2>
          <p class="mt-4 text-sand/70 text-lg leading-relaxed">
            Start with one function, or hand over the whole back office.
          </p>
        </div>
        <a href="/services" class="inline-flex items-center gap-1.5 font-semibold text-teal hover:text-teal-dark hover:gap-2.5 transition-all shrink-0">
          Explore every service
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </a>
      </div>

      <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {services.map((s, i) => (
          <a
            href={`/services/${s.id}`}
            class={`group rounded-xl border bg-sand/[0.06] border-sand/10 hover:bg-sand/[0.1] hover:border-teal/40 p-6 transition-colors card-lift reveal reveal-delay-${(i % 3) + 1}`}
          >
            <h3 class="font-semibold text-lg transition-colors group-hover:text-teal">{s.name}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-sand/65">{s.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="max-w-2xl reveal">
      <h2 class="font-[General_Sans] font-bold text-3xl md:text-4xl tracking-tight">
        Start small. Grow into a full Operations Partner.
      </h2>
      <p class="mt-4 text-slate text-lg leading-relaxed">
        Every service area is structured the same way — three tiers, each one
        a genuine step up in scope, not just a bigger invoice.
      </p>
    </div>

    <div class="mt-14 grid md:grid-cols-3 gap-6">
      <div class="rounded-2xl border border-ink/10 p-7 card-lift reveal reveal-delay-1">
        <div class="h-1.5 w-10 rounded-full bg-teal/40 mb-5"></div>
        <span class="text-xs font-bold tracking-wide text-teal-dark">L1 — CORE</span>
        <h3 class="mt-2 font-[General_Sans] font-semibold text-xl">Single service, done reliably</h3>
        <p class="mt-3 text-slate leading-relaxed">Repetitive, well-defined tasks with clear procedures. Monthly subscription, cancel anytime, live within 5 business days.</p>
      </div>
      <div class="rounded-2xl border border-ink/10 p-7 card-lift reveal reveal-delay-2">
        <div class="h-1.5 w-16 rounded-full bg-teal/70 mb-5"></div>
        <span class="text-xs font-bold tracking-wide text-teal-dark">L2 — ADVANCED</span>
        <h3 class="mt-2 font-[General_Sans] font-semibold text-xl">Broader scope, real ownership</h3>
        <p class="mt-3 text-slate leading-relaxed">Reporting, insight, and process ownership layered on top of L1. Scoped in an onboarding consult, 3-month minimum.</p>
      </div>
      <div class="rounded-2xl border-2 border-teal p-7 bg-teal/5 card-lift reveal reveal-delay-3">
        <div class="h-1.5 w-24 rounded-full bg-teal mb-5"></div>
        <span class="text-xs font-bold tracking-wide text-teal-dark">L3 — STRATEGIC</span>
        <h3 class="mt-2 font-[General_Sans] font-semibold text-xl">Your fractional Operations Partner</h3>
        <p class="mt-3 text-slate leading-relaxed">No fixed procedure — we design the solution around your business. Bespoke retainer, 6-month minimum.</p>
      </div>
    </div>
  </section>

  <section class="bg-sand-dark/60 py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-6 grid md:grid-cols-2 gap-14 items-start">
      <div class="reveal">
        <h2 class="font-[General_Sans] font-bold text-3xl md:text-4xl tracking-tight">
          AI is the backbone. A person always signs off.
        </h2>
        <p class="mt-4 text-slate text-lg leading-relaxed" style="font-family: Georgia, serif; font-style: italic;">
          Not a chatbot bolted onto the side — AI is how we deliver faster
          and more accurately, at a lower cost than a traditional outsourcing model.
        </p>
        <ul class="mt-8 space-y-4">
          {[
            'No unreviewed communication sent in your business name',
            'No financial transaction processed without human sign-off',
            'No compliance lodgement submitted without qualified review',
            'A named account manager for every client',
          ].map((item) => (
            <li class="flex gap-3">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="shrink-0 mt-0.5">
                <circle cx="10" cy="10" r="9" stroke="#4FAE7F" stroke-width="1.5"/>
                <path d="M6 10.2L8.6 12.8L14 7" stroke="#4FAE7F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="text-ink/85">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl bg-white border border-ink/10 p-8 card-lift reveal reveal-delay-2 md:mt-10">
        <h3 class="font-semibold text-sm uppercase tracking-wide text-ink/50">What AI handles</h3>
        <div class="mt-5 space-y-4">
          {[
            ['Document capture & extraction', 'Invoices, receipts, contracts read and classified automatically'],
            ['Intelligent data entry', 'Structured data validated and cross-referenced, no manual typing'],
            ['Anomaly detection', 'Unusual transactions and compliance flags surfaced early'],
            ['Drafting & reporting', 'Emails, summaries and dashboards prepared for human review'],
          ].map(([title, body]) => (
            <div class="flex gap-4 pb-4 border-b border-ink/8 last:border-0 last:pb-0">
              <div class="w-1.5 rounded-full bg-amber shrink-0"></div>
              <div>
                <p class="font-semibold text-[0.95rem]">{title}</p>
                <p class="text-slate text-sm mt-0.5">{body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <div class="rounded-3xl bg-ink text-sand px-8 py-16 md:px-16 md:py-20 text-center reveal">
      <h2 class="font-[General_Sans] font-bold text-3xl md:text-5xl tracking-tight max-w-2xl mx-auto">
        You build the business.<br />We'll handle the complexity.
      </h2>
      <p class="mt-4 text-sand/70 text-lg max-w-xl mx-auto">
        Book a scoping call and we'll map out exactly which service areas make sense to start with.
      </p>
      <a href="/contact" class="mt-8 inline-flex items-center rounded-full bg-amber text-ink px-8 py-3.5 font-semibold hover:brightness-95 hover:-translate-y-0.5 transition-all">
        Book a scoping call
      </a>
    </div>
  </section>
</Layout>
